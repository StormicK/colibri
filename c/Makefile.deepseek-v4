UNAME_S := $(shell uname -s)
IS_WIN := $(findstring MINGW,$(UNAME_S))$(findstring MSYS,$(UNAME_S))

ifneq ($(IS_WIN),)
CC = gcc
ARCH ?= x86-64-v3
CFLAGS = -D_FILE_OFFSET_BITS=64 -O3 -march=$(ARCH) -fopenmp \
	-include pthread.h -Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_EXPERIMENTAL_PARALLEL_PREFIX_VERIFY \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -static -pthread \
	-Wl,--wrap=coli_deepseek_v4_expert_store_open \
	-Wl,--wrap=coli_st_read_at \
	-Wl,--wrap=coli_v4_block_window_batch_ref \
	-Wl,--wrap=coli_v4_block_window_token_ref \
	-Wl,--wrap=coli_v4_dspark_runner_block_size \
	-Wl,--wrap=coli_v4_dspark_biased_argmax
V4_BINARY := deepseek_v4.exe
else
CC = gcc
ARCH ?= native
CFLAGS = -O3 -march=$(ARCH) -fopenmp -Wall -Wextra \
	-Wno-unused-parameter -Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_EXPERIMENTAL_PARALLEL_PREFIX_VERIFY \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -pthread \
	-Wl,--wrap=coli_deepseek_v4_expert_store_open \
	-Wl,--wrap=coli_st_read_at \
	-Wl,--wrap=coli_v4_block_window_batch_ref \
	-Wl,--wrap=coli_v4_block_window_token_ref \
	-Wl,--wrap=coli_v4_dspark_runner_block_size \
	-Wl,--wrap=coli_v4_dspark_biased_argmax
V4_BINARY := deepseek_v4
endif

SOURCES = safetensors_index.c deepseek_v4_config_dspark_compat.c \
	deepseek_v4_layer_resident.c deepseek_v4_resource_plan.c \
	deepseek_v4_head_cache.c deepseek_v4_expert_store_auto.c \
	deepseek_v4_math.c native_quant_parallel.c native_quant_dual.c \
	tensor_io.c deepseek_v4_attention.c deepseek_v4_attention_batch.c \
	deepseek_v4_compressor.c deepseek_v4_indexer.c \
	deepseek_v4_sparse_attention.c deepseek_v4_block_hybrid.c \
	deepseek_v4_dspark.c deepseek_v4_dspark_memory.c \
	deepseek_v4_dspark_runtime_resident.c deepseek_v4_dspark_expert_store.c \
	deepseek_v4_dspark_attention.c deepseek_v4_dspark_block.c \
	deepseek_v4_dspark_final.c deepseek_v4_dspark_runner.c \
	deepseek_v4_compressor_snapshot.c deepseek_v4_indexer_snapshot.c \
	deepseek_v4_attention_transaction.c deepseek_v4_target_head_batch.c \
	deepseek_v4_speculative.c deepseek_v4_dspark_heads.c \
	deepseek_v4_dspark_capture.c deepseek_v4_target_verify.c \
	deepseek_v4_target_attention_commit.c native_quant_batch_avx512.c \
	native_quant_fp4_rows16.c deepseek_v4_expert_store_hot_rows16.c \
	deepseek_v4_expert_rows16.c tools/deepseek_v4_generate_stats.c \
	deepseek_v4_route_bf16.c deepseek_v4_target_verify_prefix.c \
	deepseek_v4_runtime.c deepseek_v4_prompt.c

SCHED_SOURCE = deepseek_v4_dspark_verify_window.c

.PHONY: deepseek-v4 deepseek-v4-clean
deepseek-v4: $(V4_BINARY)

$(V4_BINARY): $(SOURCES) $(SCHED_SOURCE) \
	deepseek_v4_block.c deepseek_v4_block_pipeline.c \
	deepseek_v4_block_batch.c deepseek_v4_expert_store.c \
	native_quant.c native_quant_batch.c tok.h tok_unicode.h \
	deepseek_v4_target_verify_prefix.h deepseek_v4_runtime.h \
	deepseek_v4_prompt.h
	$(CC) $(CFLAGS) $(SOURCES) $(SCHED_SOURCE) -o $@ $(LDFLAGS)

deepseek-v4-clean:
	rm -f deepseek_v4 deepseek_v4.exe
